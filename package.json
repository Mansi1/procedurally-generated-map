{
  "name": "procedurally-generated-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run gen:models && npm run gen:anim",
    "build": "tsc && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "gen:models": "node tools/blender/models.mjs",
    "check:models": "node tools/blender/check-models.mjs",
    "test": "node --test tests/",
    "test:update-ids": "node tests/update-ids.mjs",
    "gen:ui": "node tools/ui/icons.mjs && node tools/ui/wood-bar.mjs",
    "smoke": "node tools/ui/smoke.mjs",
    "export:bognerei": "node tools/export/bognerei.mjs && node tools/export/bognerei.mjs frau",
    "export:props": "node tools/export/props.mjs",
    "gen:anim": "node tools/blender/export-all.mjs",
    "check:anim": "node tools/blender/parity.mjs && node tools/blender/parity-animals.mjs"
  },
  "devDependencies": {
    "defuss-vite": "^1.2.1",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "defuss": "^3.4.9"
  }
}
